/*
 * XIAO nRF52840 Plus overlay for OpenThread RCP.
 *
 * The xiao_ble Zephyr board file already maps UART0 to P1.11 (TX, header D6)
 * and P1.12 (RX, header D7), matching the ESP32-S3 wiring. We only need to
 * designate uart0 as the OpenThread Spinel transport — which the stock
 * xiao_ble board does not do because it isn't normally an OT target.
 */

/ {
	chosen {
		zephyr,ot-uart = &uart0;
	};
};
